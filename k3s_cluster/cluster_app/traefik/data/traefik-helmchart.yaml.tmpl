apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: traefik
  namespace: kube-system
spec:
  repo: https://traefik.github.io/charts
  chart: traefik
  version: ${version}
  targetNamespace: kube-system
  valuesContent: |-
    # Force nodePort to be set to a static values (easier to expose ports to the outside world)
    ports:
      web:
        nodePort: ${network.traefik.nodeport_http} # 30080
      websecure:
        nodePort: ${network.traefik.nodeport_https} # 30443
%{ if tsnet_enabled ~}
      # Dedicated plaintext entrypoint for tailnet traffic, fronted by a single
      # Tailscale device (TLS terminated by Tailscale upstream). No HTTP->HTTPS
      # redirect here, so internally-exposed apps route cleanly. Exposed on the
      # service so the Tailscale Ingress can reach it via ClusterIP; the auto
      # nodePort is NOT targeted by the public NLB and is SG-gated.
      tsnet:
        port: ${tsnet_port} # 8090
        expose:
          default: true
        exposedPort: ${tsnet_port} # 8090
        protocol: TCP
%{ endif ~}

    # HA: run multiple Traefik replicas
    deployment:
      replicas: ${resources.traefik.replicas.target} # 2
      podDisruptionBudget:
        enabled: true
        minAvailable: ${resources.traefik.replicas.minimum} # 1

    # Resource sizing (baseline)
    resources:
      requests:
        cpu: ${resources.traefik.req.cpu} # 50m
        memory: ${resources.traefik.req.mem} # 128Mi
      limits:
        cpu: ${resources.traefik.lmt.cpu} # 200m
        memory: ${resources.traefik.lmt.mem} # 256Mi

    # Expose the Prometheus metrics endpoint as a Service (port "metrics", :9100)
    # so the monitoring module's centralized ServiceMonitor can scrape it. We do
    # NOT enable the chart's own ServiceMonitor here — the prometheus-operator
    # CRDs don't exist yet when Traefik installs.
    metrics:
      prometheus:
        service:
          enabled: true
