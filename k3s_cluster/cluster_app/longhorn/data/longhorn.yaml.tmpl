# HelmChart: installs Longhorn distributed block storage via the K3s Helm controller
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: longhorn
  namespace: kube-system
spec:
  repo: https://charts.longhorn.io
  chart: longhorn
  version: "${version}"
  targetNamespace: longhorn-system
  createNamespace: true
  valuesContent: |-
    defaultSettings:
      # Only create disks on nodes that have longhorn.io/default-disks-annotation set.
      # This prevents Longhorn from using root disks; only explicitly registered EBS disks are used.
      createDefaultDiskLabeledNodes: true

      # Stop Longhorn's instance-manager PodDisruptionBudgets from pinning autoscaled
      # nodes in place. See issue #123.
      #
      # Longhorn gives every node's instance-manager a PDB with minAvailable:1 against a
      # selector matching exactly that one pod — so disruptionsAllowed is 0 by arithmetic
      # and never changes on its own. Longhorn releases it when it sees the node marked
      # unschedulable (`kubectl cordon`) or carrying the CLUSTER AUTOSCALER's deletion
      # taint. Karpenter is a different project and taints with karpenter.sh/disrupted,
      # which Longhorn does not recognise, so the PDB is never released and Karpenter
      # cannot drain the node. Verified on a live cluster: empty nodes sat unreclaimed
      # for 30+ minutes until cordoned by hand.
      #
      # This setting makes Longhorn keep only the PDBs it genuinely needs — one healthy
      # replica per volume stays protected, and nodes holding no replicas get no PDB at
      # all. A Karpenter node never holds replicas (createDefaultDiskLabeledNodes above
      # means it gets no disks), so it becomes freely drainable. Confirmed on a live
      # cluster: with this on, the Karpenter node had no instance-manager PDB.
      #
      # Trade-off, per Longhorn's docs: "Replica rebuilding could be expensive because
      # nodes with reusable replicas could get removed." That applies to nodes that hold
      # replicas — ours are the control-plane nodes with the EBS pools, which Karpenter
      # never touches. Longhorn also marks this setting Experimental.
      #
      # Requires volumes to have more than one replica; ours have one per AZ.
      kubernetesClusterAutoscalerEnabled: true
%{ if backup_enabled ~}
      backupTarget: "${backup_target}"
      backupTargetCredentialSecret: ""
%{ endif ~}

    # This K3s install uses the standard kubelet root dir (/var/lib/kubelet) — that is where
    # the kubelet has its pods/ and watches plugins_registry/ for CSI registration sockets.
    # Pointing kubeletRootDir at the K3s data-dir (/var/lib/rancher/k3s/agent/kubelet) makes
    # node-driver-registrar drop its socket in a directory the kubelet never watches, so the
    # driver never registers and mounts fail with "driver name driver.longhorn.io not found".
    csi:
      kubeletRootDir: "/var/lib/kubelet"
      attacherReplicaCount: 1
      provisionerReplicaCount: 1
      resizerReplicaCount: 1
      snapshotterReplicaCount: 1

    # Disable the built-in default StorageClass — we manage StorageClasses per pool below.
    persistence:
      defaultClass: false

    longhornManager:
      resources:
        requests:
          cpu: ${cfg.longhorn_manager.resources.req.cpu}
          memory: ${cfg.longhorn_manager.resources.req.mem}
        limits:
          cpu: ${cfg.longhorn_manager.resources.lmt.cpu}
          memory: ${cfg.longhorn_manager.resources.lmt.mem}

    longhornUI:
      resources:
        requests:
          cpu: ${cfg.longhorn_ui.resources.req.cpu}
          memory: ${cfg.longhorn_ui.resources.req.mem}
        limits:
          cpu: ${cfg.longhorn_ui.resources.lmt.cpu}
          memory: ${cfg.longhorn_ui.resources.lmt.mem}

    longhornDriver:
      resources:
        requests:
          cpu: ${cfg.longhorn_driver.resources.req.cpu}
          memory: ${cfg.longhorn_driver.resources.req.mem}
        limits:
          cpu: ${cfg.longhorn_driver.resources.lmt.cpu}
          memory: ${cfg.longhorn_driver.resources.lmt.mem}

%{ for pool in pools ~}
---
# StorageClass: longhorn-${pool.name}
# diskSelector=${pool.name} routes PVCs to disks tagged with this pool name.
# replica_count is derived from the number of EBS volumes in the pool (one per AZ).
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: longhorn-${pool.name}
%{ if pool.default ~}
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
%{ endif ~}
provisioner: driver.longhorn.io
parameters:
  numberOfReplicas: "${pool.replica_count}"
  dataLocality: "${pool.data_locality}"
  diskSelector: "${pool.name}"
reclaimPolicy: ${pool.reclaim_policy}
volumeBindingMode: Immediate
allowVolumeExpansion: true
%{ endfor ~}
