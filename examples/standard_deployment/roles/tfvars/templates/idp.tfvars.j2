{{ ansible_managed | comment }}
# Network/Resource Settings
aws_region = "{{ aws_region }}"
nickname   = "{{ tfvars.idp.nickname }}"

# DNS name
dns = {
  basename = "{{ dns.basename }}"
  prefix   = "{{ dns.prefix }}"
}

# Tailnet identity — set ONLY if any app uses exposure="internal".
# MUST match subsystems.tailscale in the cluster root:
#   hostname_prefix -> subsystems.tailscale.hostname_prefix (defaults to nickname)
#   magic_dns_name  -> subsystems.tailscale.magic_dns_name
# Sourced from tfvars.cluster.nickname and tfvars.tailscale.magic_dns_name so the
# roots cannot drift apart.
tailscale = {
  hostname_prefix = "{{ tfvars.cluster.nickname }}"
  magic_dns_name  = "{{ tfvars.tailscale.magic_dns_name }}"
}
