#!/bin/bash

set -euo pipefail

# SimpleK3s cluster CLI — one entry point over the ssm_*.sh tools.
#
# Phase 1 of #118: this dispatches to the existing scripts unchanged. Every
# script stays directly callable, and nothing here adds, removes or alters
# behaviour — arguments are passed through verbatim.
#
# Lives at the deployment root, beside the playbooks it will eventually drive,
# so it is invoked as ./sk3s rather than ./scripts/sk3s. The scripts it
# dispatches to stay in ./scripts/ and stay directly callable.
#
#   ./sk3s <verb> [args...]
#   ./sk3s help
#   ./sk3s <verb> --help     # the underlying script's own usage

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="${SCRIPT_DIR}/scripts"
GROUP_VARS="${SCRIPT_DIR}/group_vars/all.yml"

EXIT_OK=0
EXIT_USAGE=2

# Every run is logged here, whether or not anyone asked. --verbose only helps the
# run you predicted would fail; a log written unconditionally is the one that is
# there after the failure you did not predict. Gitignored.
LOG_DIR="${SK3S_LOG_DIR:-${SCRIPT_DIR}/logs}"

# Oldest logs beyond this are removed after each run, so the directory cannot
# grow without bound on a machine that is never tidied.
LOG_KEEP="${SK3S_LOG_KEEP:-50}"

# One line per run, so a sequence can be read without opening 50 files. NOT
# pruned alongside them: the whole point is that the trail outlives the detail.
# Capped only so it cannot grow forever — at ~150 bytes a line, the default is
# years of use.
HISTORY_FILE="${LOG_DIR}/history.log"
HISTORY_KEEP="${SK3S_HISTORY_KEEP:-10000}"

# Verbs that own the terminal. Their output cannot be piped through tee without
# breaking the session, so they run unlogged rather than half-working.
LOG_EXCLUDE=("connect")

# verb|script|fixed-args|summary
#
# sync, apply and pull are one script behind three verbs. They are the same
# machinery with different scope — files go to every node, staging goes to one —
# so splitting them into three scripts would duplicate the merged report, which
# is the only genuinely hard part.
VERBS=(
    "status|sk3s_status.py||Health of the cluster, merged across control-plane nodes (--depth quick|standard|full)"
    "sync|ssm_update_services.sh|--mode sync|Sync bootstrap files from S3 to every node"
    "apply|ssm_update_services.sh|--mode apply|Stage manifests on the node that owns staging"
    "pull|ssm_update_services.sh|--mode pull|Sync bootstrap files, then stage manifests"
    "nodes|ssm_list_instances.sh||List the cluster's EC2 instances"
    "connect|ssm_connect.sh||Open an interactive shell on a node"
    "exec|ssm_execute.sh||Run a command on a node"
    "refresh|ssm_refresh_services.sh||Restart platform workloads that are wedged"
    "repair|ssm_repair_cluster.sh||Repair a control-plane node that cannot rejoin"
)

# verb|phase|summary — named so an unbuilt verb reports its plan instead of
# "unknown", which would read as a typo rather than a roadmap.
# Empty is the expected steady state — every verb #118 planned now exists. The
# remaining phases add flags and move callers, not verbs, so the section below
# disappears from help rather than listing nothing.
PLANNED=()

function field() {
    # field <entry> <n>   — nth |-separated field, 1-indexed
    local _ENTRY="${1}" _N="${2}" _I
    for ((_I = 1; _I < _N; _I++)); do
        _ENTRY="${_ENTRY#*|}"
    done
    printf '%s' "${_ENTRY%%|*}"
}

function rest() {
    # rest <entry> <n>   — everything from the nth |-separated field onward.
    #
    # The LAST field must not be cut at a delimiter. A summary legitimately
    # contains "|" — the --depth values do — and field() truncated the help to
    # "(--depth quick", which read as a broken CLI on the first line a new
    # operator sees.
    local _ENTRY="${1}" _N="${2}" _I
    for ((_I = 1; _I < _N; _I++)); do
        _ENTRY="${_ENTRY#*|}"
    done
    printf '%s' "${_ENTRY}"
}

# Read a top-level scalar out of group_vars/all.yml. Returns non-zero when the
# file is absent (it is gitignored, so a fresh clone has none), when the key is
# missing, or when the value is still the __CONFIGURE_THIS__ placeholder.
#
# Deliberately not a YAML parser: this reads one top-level scalar, and the
# alternative is a third-party dependency for a single string.
function infer_group_var() {
    local _FILE="${1}" _KEY="${2}" _VALUE
    [[ -f "${_FILE}" ]] || return 1
    _VALUE="$(grep -m1 -E "^${_KEY}[[:space:]]*:" "${_FILE}" | cut -d: -f2-)" || return 1
    # trim surrounding whitespace, then a matched pair of quotes
    _VALUE="${_VALUE#"${_VALUE%%[![:space:]]*}"}"
    _VALUE="${_VALUE%"${_VALUE##*[![:space:]]}"}"
    if [[ "${_VALUE}" == \"*\" || "${_VALUE}" == \'*\' ]]; then
        _VALUE="${_VALUE:1:${#_VALUE}-2}"
    fi
    [[ -n "${_VALUE}" && "${_VALUE}" != "__CONFIGURE_THIS__" ]] || return 1
    printf '%s' "${_VALUE}"
}

function usage() {
    # Explicit --help goes to stdout and exits 0; usage shown because of an
    # error goes to stderr and exits 2.
    local _CODE="${1:-${EXIT_USAGE}}"
    local _FD=2
    local _ENTRY
    (( _CODE == EXIT_OK )) && _FD=1
    {
        echo "SimpleK3s cluster CLI"
        echo ""
        echo "Usage: $(basename "$0") <verb> [args...]"
        echo ""
        echo "Verbs:"
        for _ENTRY in "${VERBS[@]}"; do
            printf '  %-9s %s\n' "$(field "${_ENTRY}" 1)" "$(rest "${_ENTRY}" 4)"
        done
        if (( ${#PLANNED[@]} > 0 )); then
            echo ""
            echo "Planned:"
            for _ENTRY in "${PLANNED[@]}"; do
                printf '  %-9s %s (phase %s)\n' \
                    "$(field "${_ENTRY}" 1)" "$(rest "${_ENTRY}" 3)" "$(field "${_ENTRY}" 2)"
            done
        fi
        echo ""
        echo "Every verb takes <profile> [<nickname> <region>] first. Omit the"
        echo "profile and aws_profile_for_scripts from group_vars/all.yml is used;"
        echo "nickname and region are inferred from terraform.tfvars. See the"
        echo "Script Conventions section of README.md."
        echo ""
        echo "  $(basename "$0") <verb> --help    Usage for that verb"
        echo ""
        echo "Every run is logged to logs/ (except 'connect', which owns the"
        echo "terminal). SK3S_NO_LOG=1 withholds the OUTPUT but still records the"
        echo "command, timings and exit code. SK3S_LOG_DIR relocates the"
        echo "directory; SK3S_LOG_KEEP sets how many are kept (default ${LOG_KEEP})."
        echo ""
        echo "Scope: sync reaches every control-plane node (--all-nodes adds agent"
        echo "       and Karpenter nodes). Staging acts on the one node that owns"
        echo "       it, read from the cluster rather than inferred from a node's"
        echo "       index. --instance-id restricts a verb to a single node."
    } >&"${_FD}"
    exit "${_CODE}"
}

function script_for() {
    local _VERB="${1}" _ENTRY
    for _ENTRY in "${VERBS[@]}"; do
        if [[ "$(field "${_ENTRY}" 1)" == "${_VERB}" ]]; then
            field "${_ENTRY}" 2
            return 0
        fi
    done
    return 1
}

# Arguments the verb always passes to its script, before the caller's own.
# Empty for verbs that map one-to-one onto a script.
function args_for() {
    local _VERB="${1}" _ENTRY
    for _ENTRY in "${VERBS[@]}"; do
        if [[ "$(field "${_ENTRY}" 1)" == "${_VERB}" ]]; then
            field "${_ENTRY}" 3
            return 0
        fi
    done
    return 1
}

function planned_phase_for() {
    local _VERB="${1}" _ENTRY
    for _ENTRY in ${PLANNED[@]+"${PLANNED[@]}"}; do
        if [[ "$(field "${_ENTRY}" 1)" == "${_VERB}" ]]; then
            field "${_ENTRY}" 2
            return 0
        fi
    done
    return 1
}

# GATHER INPUTS
VERB="${1:-}"

# VERIFY INPUTS
if [[ -z "${VERB}" ]]; then
    usage "${EXIT_USAGE}"
fi
case "${VERB}" in
    -h | --help | help)
        usage "${EXIT_OK}"
        ;;
esac
shift

if PHASE="$(planned_phase_for "${VERB}")"; then
    echo "Error: '${VERB}' is planned but not implemented yet (#118, phase ${PHASE})." >&2
    exit "${EXIT_USAGE}"
fi

if ! TARGET="$(script_for "${VERB}")"; then
    echo "Error: unknown verb '${VERB}'." >&2
    echo "" >&2
    usage "${EXIT_USAGE}"
fi

# Arguments the verb contributes itself, placed BEFORE the caller's so an
# operator can still override them explicitly if they ever need to.
#
# Split into an array rather than expanded unquoted at each call site: word
# splitting scattered across four dispatch points is four chances to get the
# quoting subtly different.
FIXED_ARGS="$(args_for "${VERB}")"
FIXED_ARR=()
if [[ -n "${FIXED_ARGS}" ]]; then
    # shellcheck disable=SC2206  # deliberate splitting of a known-safe literal
    FIXED_ARR=(${FIXED_ARGS})
fi
# bash 3.2 (macOS) trips `set -u` on "${arr[@]}" when the array is empty.
FIXED=("${FIXED_ARR[@]+"${FIXED_ARR[@]}"}")

# A help request is not a cluster operation, so it must never be given a
# profile: injecting one pushes --help into $2, where a target that only
# inspects $1 stops recognising it and reports a bogus argument-count error.
WANTS_HELP="false"
for _ARG in "$@"; do
    if [[ "${_ARG}" == "-h" || "${_ARG}" == "--help" ]]; then
        WANTS_HELP="true"
        break
    fi
done

# Supply the profile when none was given. Every verb takes it as the first
# positional, so "absent" means no arguments at all or a flag in first position.
# On failure this stays silent and passes through — the target script already
# reports a missing profile, and inventing a second error path helps nobody.
if [[ "${WANTS_HELP}" == "false" ]] && [[ $# -eq 0 || "${1}" == -* ]]; then
    if PROFILE="$(infer_group_var "${GROUP_VARS}" "aws_profile_for_scripts")"; then
        echo "Profile  : ${PROFILE}  (group_vars/all.yml: aws_profile_for_scripts)" >&2
        set -- "${PROFILE}" "$@"
    fi
fi

function logging_wanted() {
    local _V
    # A help request produces no cluster interaction worth keeping.
    [[ "${WANTS_HELP}" == "true" ]] && return 1
    for _V in "${LOG_EXCLUDE[@]}"; do
        [[ "${VERB}" == "${_V}" ]] && return 1
    done
    return 0
}

# SK3S_NO_LOG withholds the OUTPUT, not the entry. Suppressing the whole record
# would delete the audit trail exactly where it matters most: the runs an
# operator opts out of are the ones handling sensitive output, so erasing them
# removes the entry most worth having. Command, timings and exit code are still
# recorded, and the log states plainly that the body was withheld.
function log_output_wanted() {
    [[ "${SK3S_NO_LOG:-0}" != "1" ]]
}

# Shell-quote one argument so the log preserves where arguments began and ended.
# Without this, `--exec-cmd "rm -rf /tmp/a b"` and `--exec-cmd rm -rf /tmp/a b`
# log identically, which for an audit trail is the difference between two very
# different commands. Only arguments that need quoting get it, so the ordinary
# case stays readable.
function quote_arg() {
    local _A="${1}"
    if [[ -n "${_A}" && "${_A}" =~ ^[A-Za-z0-9_./:=@%+,-]+$ ]]; then
        printf '%s' "${_A}"
        return 0
    fi
    # POSIX single-quoting: close the quote, emit an escaped quote, reopen —
    # i.e. ' becomes '\''. Done with sed rather than parameter expansion because
    # inside double quotes bash does not treat \' as an escape, so the expansion
    # form silently emits literal backslashes.
    printf "'%s'" "$(printf '%s' "${_A}" | sed "s/'/'\\\\''/g")"
}

function quote_cmd() {
    local _OUT="" _A
    for _A in "$@"; do
        _OUT+="$(quote_arg "${_A}") "
    done
    printf '%s' "${_OUT% }"
}

function utc_now() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Append one history line. Failure here must never take down the command it is
# describing, hence the swallowed error.
#   history_write <status> <duration> <verb> <detail-file> <command...>
function history_write() {
    local _STATUS="${1}" _DURATION="${2}" _VERB="${3}" _DETAIL="${4}"
    shift 4
    mkdir -p "${LOG_DIR}" 2>/dev/null || return 0
    printf '%s  %-8s %6s  %-18s %-34s %s\n' \
        "$(utc_now)" "${_STATUS}" "${_DURATION}" "${_VERB}" "${_DETAIL}" "$(quote_cmd "$@")" \
        >> "${HISTORY_FILE}" 2>/dev/null || true
}

function prune_history() {
    local _LINES _TMP
    [[ -f "${HISTORY_FILE}" ]] || return 0
    _LINES="$(wc -l < "${HISTORY_FILE}" 2>/dev/null | tr -d ' ')"
    [[ "${_LINES}" =~ ^[0-9]+$ ]] || return 0
    (( _LINES <= HISTORY_KEEP )) && return 0
    _TMP="${HISTORY_FILE}.tmp.$$"
    tail -n "${HISTORY_KEEP}" "${HISTORY_FILE}" > "${_TMP}" 2>/dev/null \
        && mv "${_TMP}" "${HISTORY_FILE}" 2>/dev/null || rm -f "${_TMP}"
}

# Short id tying a connect session's opened/closed pair together.
function session_id() {
    printf '%06x' "$(( (RANDOM << 15 | RANDOM) & 0xFFFFFF ))"
}

# Keep the newest LOG_KEEP files and drop the rest. Sorted by name, which is
# chronological because the timestamp is fixed-width and UTC.
function prune_logs() {
    local _FILES
    _FILES="$(ls -1 "${LOG_DIR}"/sk3s_*.log 2>/dev/null | sort -r | tail -n +"$((LOG_KEEP + 1))")"
    [[ -z "${_FILES}" ]] && return 0
    printf '%s\n' "${_FILES}" | while IFS= read -r _F; do
        [[ -n "${_F}" ]] && rm -f "${_F}"
    done
}

# EXECUTE SCRIPT

# A help request touches no cluster and is not part of the audit trail, so it is
# the one path that still replaces this process outright.
if [[ "${WANTS_HELP}" == "true" ]]; then
    exec "${SCRIPTS_DIR}/${TARGET}" "${FIXED[@]+"${FIXED[@]}"}" "$@"
fi

STARTED_EPOCH="$(date -u +%s)"

# Recorded for the interrupt handler, which cannot take arguments.
HISTORY_CMD=("sk3s" "${VERB}" "$@")
HISTORY_DETAIL="-"

# An interrupted run must still appear. Ctrl-C signals the whole process group,
# so without this bash exits before reaching the history write and the run
# vanishes — the same hole SK3S_NO_LOG was changed to avoid. 130 is the
# conventional status for SIGINT.
function on_interrupt() {
    trap - INT TERM
    history_write "interrupted" "$(( $(date -u +%s) - STARTED_EPOCH ))s" \
        "${VERB}" "${HISTORY_DETAIL}" "${HISTORY_CMD[@]}"
    prune_history
    exit 130
}
trap on_interrupt INT TERM

# `connect` owns the terminal: its output cannot be teed without breaking the
# session, so no per-run log exists for it. It IS recorded in history though —
# somebody opening an interactive shell on a node is the single most
# audit-relevant thing this tool does, and leaving it invisible was the largest
# gap in the trail.
#
# Two lines, because a session can last hours: one when it opens, one when it
# closes. Writing only on close would place the entry out of order relative to
# everything that happened during the session, and would make a session that is
# still open — or that died with the terminal — invisible entirely.
if ! logging_wanted; then
    SESSION="$(session_id)"
    VERB="${VERB}[${SESSION}]"
    history_write "opened" "-" "${VERB}" "-" "${HISTORY_CMD[@]}"

    # A child, not exec: this shell has to survive to close the session out. The
    # terminal still passes through, so the session itself is unaffected.
    set +e
    "${SCRIPTS_DIR}/${TARGET}" "${FIXED[@]+"${FIXED[@]}"}" "$@"
    TARGET_STATUS=$?
    set -e

    history_write "exit=${TARGET_STATUS}" "$(( $(date -u +%s) - STARTED_EPOCH ))s" \
        "${VERB}" "-" "(session closed)"
    prune_history
    exit "${TARGET_STATUS}"
fi

mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/sk3s_${VERB}_$(date -u +%Y%m%dT%H%M%SZ).log"

HISTORY_DETAIL="$(basename "${LOG_FILE}")"

{
    printf '# %s\n' "$(quote_cmd "${HISTORY_CMD[@]}")"
    printf '# started : %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# target  : %s %s\n' "${SCRIPTS_DIR}/${TARGET}" "${FIXED_ARGS}"
    printf '#\n'
} >> "${LOG_FILE}"

if log_output_wanted; then
    # Streams are teed SEPARATELY rather than merged. Merging would put progress
    # on stdout and break `sk3s nodes --json | jq`, which the conventions promise
    # works.
    #
    # fd 3/4 are closed before waiting so each tee sees EOF and drains; without
    # that the last lines — usually the interesting ones — can be lost when the
    # shell exits first.
    exec 3> >(tee -a "${LOG_FILE}")
    exec 4> >(tee -a "${LOG_FILE}" >&2)

    set +e
    "${SCRIPTS_DIR}/${TARGET}" "${FIXED[@]+"${FIXED[@]}"}" "$@" >&3 2>&4
    TARGET_STATUS=$?
    set -e

    exec 3>&- 4>&-
    wait
else
    # Stated explicitly, so a reader can tell a withheld body from a command that
    # simply produced no output.
    printf '# (output withheld — SK3S_NO_LOG=1)\n' >> "${LOG_FILE}"
    set +e
    "${SCRIPTS_DIR}/${TARGET}" "${FIXED[@]+"${FIXED[@]}"}" "$@"
    TARGET_STATUS=$?
    set -e
fi

{
    printf '#\n'
    printf '# exit    : %d\n' "${TARGET_STATUS}"
    printf '# finished: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >> "${LOG_FILE}"

history_write "exit=${TARGET_STATUS}" "$(( $(date -u +%s) - STARTED_EPOCH ))s" \
    "${VERB}" "${HISTORY_DETAIL}" "${HISTORY_CMD[@]}"

prune_logs
prune_history
exit "${TARGET_STATUS}"
