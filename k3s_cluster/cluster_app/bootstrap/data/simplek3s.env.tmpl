K3S_INSTALL_URL="https://get.k3s.io"
K3S_VERSION="${k3s_version}"
K3S_MANIFEST_DIR="/var/lib/rancher/k3s/server/manifests"

BOOTSTRAP_DIR="${bootstrap_dir}"
NICKNAME="${nickname}"
AWS_REGION="${aws_region}"
CONTROLLER_HOST="${controller_host}"
SWAPFILE_ALLOC_AMT="${swapfile_alloc_amt}"

# kubelet --kube-reserved, per plane. K3s reserves nothing by default, which
# leaves Allocatable == Capacity and lets the scheduler hand out memory the k3s
# server is already using. lib/common.sh selects by node role at install time.
KUBE_RESERVED_CONTROLPLANE="${kube_reserved_controlplane}"
KUBE_RESERVED_AGENT="${kube_reserved_agent}"

PARAMSTORE_KEYROOT="${pstore_key_root}"

S3_BUCKET_NAME="${s3_bucket_name}"
