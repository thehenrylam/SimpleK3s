{
  "nodes": {
    "$each": {
      "role": { "$regex": "controlplane|agentplane" },
      "name": { "$ignore": true },
      "hardware": {
        "cpu": {
          "load": { "$ignore": true },
          "usage": { "$ignore": true }
        },
        "memory": {
          "ram": {
            "usage": { "$ignore": true },
            "free (MB)": { "$ignore": true },
            "used (MB)": { "$ignore": true },
            "total (MB)": { "$gte": 1 }
          },
          "swap": { "$ignore": true }
        },
        "disk": {
          "usage": { "$warn": { "$lte": 85 } },
          "free (MB)": { "$ignore": true },
          "used (MB)": { "$ignore": true },
          "total (MB)": { "$gte": 1 }
        }
      }
    }
  },
