# Single tailnet entry point: one Tailscale device (Ingress, L7 — Tailscale
# terminates TLS with a valid MagicDNS cert) that fronts Traefik's dedicated
# plaintext `tsnet` entrypoint. Internally-exposed apps are then reached at
# https://${hostname_prefix}.<your-tailnet>.ts.net/<app-path>, with Traefik doing
# the host-scoped path routing (mirrors external mode). Lives in the Traefik
# Service's namespace because a Kubernetes Ingress backend is same-namespace.
#
# Staged with every other manifest. The operator's ingress-reconciler gives up
# permanently if it sees this Ingress before the `${hostname_prefix}-proxy`
# ProxyClass (in tailscale-helmchart.yaml) is Ready: it logs "not (yet) Ready,
# waiting.." and (in operator v1.98.4) is never re-triggered when the ProxyClass
# does go Ready. That is the normal cold-boot ordering, so the proxy device ends
# up uncreated. Staging cannot fix this — the Ingress applies cleanly on the
# first attempt, so the K3s deploy controller has nothing to retry.
# converge_actions.sh repairs it afterwards by restarting the operator (#126).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: tailnet-entrypoint
  namespace: ${traefik_namespace}
spec:
  ingressClassName: tailscale
  tls:
    - hosts:
        - ${hostname_prefix}
  rules:
    - host: ${hostname_prefix}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ${traefik_service}
                port:
                  number: ${traefik_port}
