# Namespace (optional; HelmChart can create it too, but having it here is fine)
apiVersion: v1
kind: Namespace
metadata:
  name: monitoring

---
# SecretStore: AWS SSM Parameter Store for monitoring namespace
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: parameterstore
  namespace: monitoring
spec:
  provider:
    aws:
      service: ParameterStore
      region: ${region_idp_config}

---
# ExternalSecret: pulls issuer/client/secret into a Secret named grafana-sso
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: grafana-oidc-into-secret
  namespace: monitoring
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: parameterstore
    kind: SecretStore
  target:
    name: grafana-sso
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
  data:
    - secretKey: oidc.cognito.domain
      remoteRef:
        key: ${pstore_idp_config}
        property: domain
    - secretKey: oidc.cognito.client
      remoteRef:
        key: ${pstore_idp_config}
        property: client_id
    - secretKey: oidc.cognito.secret
      remoteRef:
        key: ${pstore_idp_config}
        property: client_secret


---
# HelmChart: installs your wrapper chart from GitHub Pages
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: prometheus
  namespace: kube-system
spec:
  repo: "https://thehenrylam.github.io/EasyHelmChart-Prometheus/"
  chart: "prometheus"
  version: "${version}"
  targetNamespace: "monitoring"
  createNamespace: true

  # ALL chart values live here, NOT in a separate HelmChartConfig. The K3s
  # helm-controller can run the HelmChart's install before a sibling
  # HelmChartConfig is merged in; that first install would then render the
  # Prometheus/Alertmanager CRs WITHOUT their storageSpec. The operator builds
  # their StatefulSets on emptyDir, and StatefulSet volumeClaimTemplates are
  # immutable — so the storage values can never be applied afterward (the CRs
  # stay storage-less even though the release record later shows them). Keeping
  # every value in the HelmChart's own valuesContent guarantees the first (and
  # only) install carries storage, so the StatefulSets are born with PVCs.
  valuesContent: |-
    kube-prometheus-stack:
      grafana:
        enabled: true
        # Ship kube-prometheus-stack's built-in dashboards (node/pod/cluster health).
        # Custom hand-authored dashboards are a later pass.
        defaultDashboardsEnabled: true
        # Point Grafana's auto-provisioned default Prometheus datasource at the
        # Thanos Querier instead of Prometheus directly, so dashboards see both
        # recent (sidecar) and historical (S3 via Store Gateway) data through one
        # endpoint.
        sidecar:
          datasources:
            url: http://thanos-query.monitoring.svc.cluster.local:9090
        resources:
          requests:
            cpu: ${cfg.grafana.resources.req.cpu} # 50m
            memory: ${cfg.grafana.resources.req.mem} # 256Mi
          limits:
            cpu: ${cfg.grafana.resources.lmt.cpu} # 300m
            memory: ${cfg.grafana.resources.lmt.mem} # 512Mi
%{ if storage.grafana_enabled ~}
        persistence:
          enabled: true
          storageClassName: "${storage.storage_class_name}"
          size: "${storage.grafana_pvc_size}Gi"
%{ endif ~}
        grafana.ini:
          server:
            root_url: "https://${domain_name}/grafana"
            serve_from_sub_path: true

          # Land every user on the curated "SimpleK3s - Start Here" index dashboard.
          # The dashboard sidecar writes provisioned dashboards into /tmp/dashboards,
          # named after the ConfigMap data key (see ConfigMap below).
          dashboards:
            default_home_dashboard_path: /tmp/dashboards/simplek3s-start-here.json

          users:
            auto_assign_org_role: Viewer

          auth:
            disable_login_form: false
            oauth_auto_login: false

          auth.generic_oauth:
            enabled: true
            name: Cognito
            allow_sign_up: true
            scopes: "openid profile email"
            # These endpoints depend on your IdP; for Cognito they're typically:
            # TEMPLATING ON TERRAFORM: Using two $ chars allows Terraform to 'ignore' that var from templating
            auth_url: "$${GF_OIDC_DOMAIN}/oauth2/authorize"
            token_url: "$${GF_OIDC_DOMAIN}/oauth2/token"
            api_url: "$${GF_OIDC_DOMAIN}/oauth2/userInfo"

        # Inject env vars from the grafana-sso Secret created by External Secrets
        envValueFrom:
          GF_OIDC_DOMAIN:
            secretKeyRef:
              name: grafana-sso
              key: oidc.cognito.domain
          # Same as setting auth.generic_oauth.client_id
          GF_AUTH_GENERIC_OAUTH_CLIENT_ID:
            secretKeyRef:
              name: grafana-sso
              key: oidc.cognito.client
          # Same as setting auth.generic_oauth.client_secret
          GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
            secretKeyRef:
              name: grafana-sso
              key: oidc.cognito.secret

      prometheus:
        prometheusSpec:
          routePrefix: /prometheus
          externalUrl: https://${domain_name}/prometheus
          # Global scrape cadence; ServiceMonitors below inherit it unless they
          # pin their own interval.
          scrapeInterval: ${scrape_interval}
          # Time-based sliding window (e.g. 67d = 60d + a 1-week buffer).
          retention: ${prometheus_retention}
%{ if storage.prometheus_enabled ~}
          # Size cap (~85% of the PVC) so the disk never fills hard; whichever of
          # retention/retentionSize hits first trims the oldest blocks. Only set
          # when backed by a PVC — meaningless/risky on emptyDir.
          retentionSize: "${prometheus_retention_size}"
%{ endif ~}
          # Hand block compaction to the Thanos Compactor: the sidecar uploads raw
          # 2h blocks to S3 and all compaction/downsampling happens there. Required
          # so local compaction never races the sidecar's uploads.
          disableCompaction: true
          # Thanos sidecar: ships completed TSDB blocks to S3 using the objstore
          # config in the thanos-objstore-config Secret (defined below). The
          # operator injects the sidecar container into the Prometheus pod.
          thanos:
            objectStorageConfig:
              existingSecret:
                name: thanos-objstore-config
                key: objstore.yml
            # Resource requests/limits for the operator-injected sidecar container
            # (required by the cluster's require-requests-limits Kyverno policy).
            resources:
              requests:
                cpu: ${thanos_sidecar.resources.req.cpu}
                memory: ${thanos_sidecar.resources.req.mem}
              limits:
                cpu: ${thanos_sidecar.resources.lmt.cpu}
                memory: ${thanos_sidecar.resources.lmt.mem}
          # Discover ServiceMonitors/PodMonitors that do NOT carry the chart's
          # release label — our centralized monitors (added below) don't have it.
          serviceMonitorSelectorNilUsesHelmValues: false
          podMonitorSelectorNilUsesHelmValues: false
          probeSelectorNilUsesHelmValues: false
          ruleSelectorNilUsesHelmValues: false
          resources:
            requests:
              cpu: ${cfg.prometheus.resources.req.cpu} # 200m
              memory: ${cfg.prometheus.resources.req.mem} # 1Gi
            limits:
              cpu: ${cfg.prometheus.resources.lmt.cpu} # 1000m
              memory: ${cfg.prometheus.resources.lmt.mem} # 2Gi
%{ if storage.prometheus_enabled ~}
          storageSpec:
            volumeClaimTemplate:
              spec:
                storageClassName: "${storage.storage_class_name}"
                accessModes: ["ReadWriteOnce"]
                resources:
                  requests:
                    storage: "${storage.prometheus_pvc_size}Gi"
%{ endif ~}
        # Headless Service exposing the sidecar's gRPC StoreAPI (port 10901). The
        # Thanos Querier discovers it via DNS SRV; the Service is named
        # prometheus-kube-prometheus-thanos-discovery (chart fullname).
        thanosService:
          enabled: true

      alertmanager:
        alertmanagerSpec:
          resources:
            requests:
              cpu: ${cfg.alertmanager.resources.req.cpu} # 50m
              memory: ${cfg.alertmanager.resources.req.mem} # 128Mi
            limits:
              cpu: ${cfg.alertmanager.resources.lmt.cpu} # 200m
              memory: ${cfg.alertmanager.resources.lmt.mem} # 256Mi
%{ if storage.alertmanager_enabled ~}
          storage:
            volumeClaimTemplate:
              spec:
                storageClassName: "${storage.storage_class_name}"
                accessModes: ["ReadWriteOnce"]
                resources:
                  requests:
                    storage: "${storage.alertmanager_pvc_size}Gi"
%{ endif ~}

      prometheusOperator:
        resources:
          requests:
            cpu: ${cfg.prometheusOperator.resources.req.cpu} # 100m
            memory: ${cfg.prometheusOperator.resources.req.mem} # 256Mi
          limits:
            cpu: ${cfg.prometheusOperator.resources.lmt.cpu} # 500m
            memory: ${cfg.prometheusOperator.resources.lmt.mem} # 512Mi

      kube-state-metrics:
        resources:
          requests:
            cpu: ${cfg.kube-state-metrics.resources.req.cpu} # 50m
            memory: ${cfg.kube-state-metrics.resources.req.mem} # 128Mi
          limits:
            cpu: ${cfg.kube-state-metrics.resources.lmt.cpu} # 200m
            memory: ${cfg.kube-state-metrics.resources.lmt.mem} # 256Mi

      prometheus-node-exporter:
        resources:
          requests:
            cpu: ${cfg.prometheus-node-exporter.resources.req.cpu} # 25m
            memory: ${cfg.prometheus-node-exporter.resources.req.mem} # 64Mi
          limits:
            cpu: ${cfg.prometheus-node-exporter.resources.lmt.cpu} # 100m
            memory: ${cfg.prometheus-node-exporter.resources.lmt.mem} # 128Mi

      # k3s binds these control-plane components' metrics to 127.0.0.1, so their
      # stock ServiceMonitors would sit permanently "down". Disable them to keep
      # dashboards clean. Cluster health is still covered by apiserver +
      # kube-state-metrics + node-exporter + kubelet/cAdvisor + default alerts.
      # (Exposing them via k3s --bind-address=0.0.0.0 flags is a later pass.)
      kubeControllerManager:
        enabled: false
      kubeScheduler:
        enabled: false
      kubeProxy:
        enabled: false
      kubeEtcd:
        enabled: false

---
# Ingress: Prometheus UI at https://${domain_name}/prometheus/
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: prometheus-ui
  namespace: monitoring
  annotations:
    kubernetes.io/ingress.class: traefik
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  tls:
    - hosts:
        - disabled.${domain_name} # Disabled to prevent unauthorized access, to allow access, use: ${domain_name}
  rules:
    - host: disabled.${domain_name} # Disabled to prevent unauthorized access, to allow access, use: ${domain_name}
      http:
        paths:
          - path: /prometheus
            pathType: Prefix
            backend:
              service:
                name: prometheus-kube-prometheus-prometheus
                port:
                  number: 9090

---
# Ingress: Grafana UI at https://${domain_name}/grafana/
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grafana-ui
  namespace: monitoring
  annotations:
    kubernetes.io/ingress.class: traefik
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  tls:
    - hosts:
        - ${domain_name}
  rules:
    - host: ${domain_name}
      http:
        paths:
          - path: /grafana
            pathType: Prefix
            backend:
              service:
                name: prometheus-grafana
                port:
                  number: 80

# ---------------------------------------------------------------------------
# Centralized ServiceMonitors for the pre-built subsystems/apps.
#
# These live in the monitoring namespace and target each component's metrics
# Service in its own namespace. They are defined here (not in each subsystem's
# manifest) because the prometheus-operator CRDs only exist after this chart
# installs LAST; a subsystem cannot create a ServiceMonitor at its own install
# time. Discovery relies on the *SelectorNilUsesHelmValues: false gates set in
# the Prometheus spec above. Descheduler is intentionally omitted (CronJob mode
# = ephemeral Job pods, no stable scrape target).
# ---------------------------------------------------------------------------
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: traefik
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [kube-system]
  selector:
    matchLabels:
      app.kubernetes.io/name: traefik
  endpoints:
    - port: metrics
      path: /metrics
      interval: ${scrape_interval}

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: kyverno
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [kyverno]
  selector:
    matchLabels:
      app.kubernetes.io/part-of: kyverno
  endpoints:
    - port: metrics-port
      path: /metrics
      interval: ${scrape_interval}

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: external-secrets
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [external-secrets]
  selector:
    matchLabels:
      app.kubernetes.io/instance: external-secrets
  endpoints:
    - port: metrics
      path: /metrics
      interval: ${scrape_interval}

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: longhorn
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [longhorn-system]
  selector:
    matchLabels:
      app: longhorn-manager
  endpoints:
    - port: manager
      path: /metrics
      interval: ${scrape_interval}

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: karpenter
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [kube-system]
  selector:
    matchLabels:
      app.kubernetes.io/name: karpenter
  endpoints:
    - port: http-metrics
      path: /metrics
      interval: ${scrape_interval}

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: argocd
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [argocd]
  selector:
    matchLabels:
      app.kubernetes.io/part-of: argocd
  endpoints:
    - port: metrics
      path: /metrics
      interval: ${scrape_interval}

---
# Curated "SimpleK3s - Start Here" index dashboard. The grafana_dashboard label
# makes the kube-prometheus-stack Grafana sidecar load it; it's tagged
# Recommended-by-SimpleK3s and set as the default home dashboard (grafana.ini
# above). The JSON is injected verbatim from data/dashboards/simplek3s-start-here.json.
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-simplek3s-start-here
  namespace: monitoring
  labels:
    grafana_dashboard: "1"
data:
  simplek3s-start-here.json: |-
    ${indent(4, recommended_dashboard_json)}

# ---------------------------------------------------------------------------
# Thanos: long-term metrics storage on S3.
#
# The Thanos sidecar (configured in the Prometheus spec above) ships TSDB
# blocks to the S3 bucket described by this objstore Secret. The Store Gateway
# reads those blocks back, the Compactor compacts/downsamples/expires them, and
# the Querier fans out over both the sidecar (recent) and Store Gateway
# (historical) so Grafana queries everything through one endpoint.
#
# S3 auth uses aws_sdk_auth (the EC2 node instance profile) — no access keys.
# ---------------------------------------------------------------------------
---
apiVersion: v1
kind: Secret
metadata:
  name: thanos-objstore-config
  namespace: monitoring
type: Opaque
stringData:
  objstore.yml: |-
    type: S3
    config:
      bucket: "${thanos_bucket}"
      endpoint: "${thanos_endpoint}"
      region: "${thanos_region}"
      aws_sdk_auth: true

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: thanos-store
  namespace: monitoring
  labels:
    app.kubernetes.io/name: thanos-store
    app.kubernetes.io/part-of: thanos
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: thanos-store
  template:
    metadata:
      labels:
        app.kubernetes.io/name: thanos-store
        app.kubernetes.io/part-of: thanos
    spec:
      containers:
        - name: thanos-store
          image: "${thanos_image}"
          args:
            - store
            - --data-dir=/var/thanos/store
            - --objstore.config-file=/etc/thanos/objstore.yml
            - --http-address=0.0.0.0:10902
            - --grpc-address=0.0.0.0:10901
          ports:
            - name: grpc
              containerPort: 10901
            - name: http
              containerPort: 10902
          volumeMounts:
            - name: objstore-config
              mountPath: /etc/thanos
              readOnly: true
            - name: data
              mountPath: /var/thanos/store
          resources:
            requests:
              cpu: ${thanos_store.resources.req.cpu}
              memory: ${thanos_store.resources.req.mem}
            limits:
              cpu: ${thanos_store.resources.lmt.cpu}
              memory: ${thanos_store.resources.lmt.mem}
      volumes:
        - name: objstore-config
          secret:
            secretName: thanos-objstore-config
        # Block cache is rebuildable from S3, so emptyDir keeps it off EBS.
        - name: data
          emptyDir: {}

---
apiVersion: v1
kind: Service
metadata:
  name: thanos-store
  namespace: monitoring
  labels:
    app.kubernetes.io/name: thanos-store
spec:
  clusterIP: None
  selector:
    app.kubernetes.io/name: thanos-store
  ports:
    - name: grpc
      port: 10901
      targetPort: 10901
    - name: http
      port: 10902
      targetPort: 10902

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: thanos-query
  namespace: monitoring
  labels:
    app.kubernetes.io/name: thanos-query
    app.kubernetes.io/part-of: thanos
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: thanos-query
  template:
    metadata:
      labels:
        app.kubernetes.io/name: thanos-query
        app.kubernetes.io/part-of: thanos
    spec:
      containers:
        - name: thanos-query
          image: "${thanos_image}"
          args:
            - query
            - --http-address=0.0.0.0:9090
            - --grpc-address=0.0.0.0:10901
            # Operator-injected external label on every Prometheus replica; lets
            # the Querier dedupe across replicas (and is harmless with one).
            - --query.replica-label=prometheus_replica
            # DNS SRV discovery of the sidecar StoreAPI and the Store Gateway.
            # The sidecar Service is named by kube-prometheus-stack's fullname
            # ("<release>-kube-prometheus-thanos-discovery"); the release here is
            # "prometheus", matching the other prometheus-kube-prometheus-* svcs.
            - --endpoint=dnssrv+_grpc._tcp.prometheus-kube-prometheus-thanos-discovery.monitoring.svc.cluster.local
            - --endpoint=dnssrv+_grpc._tcp.thanos-store.monitoring.svc.cluster.local
          ports:
            - name: http
              containerPort: 9090
            - name: grpc
              containerPort: 10901
          resources:
            requests:
              cpu: ${thanos_query.resources.req.cpu}
              memory: ${thanos_query.resources.req.mem}
            limits:
              cpu: ${thanos_query.resources.lmt.cpu}
              memory: ${thanos_query.resources.lmt.mem}

---
apiVersion: v1
kind: Service
metadata:
  name: thanos-query
  namespace: monitoring
  labels:
    app.kubernetes.io/name: thanos-query
spec:
  selector:
    app.kubernetes.io/name: thanos-query
  ports:
    - name: http
      port: 9090
      targetPort: 9090
    - name: grpc
      port: 10901
      targetPort: 10901

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: thanos-compactor
  namespace: monitoring
  labels:
    app.kubernetes.io/name: thanos-compactor
    app.kubernetes.io/part-of: thanos
spec:
  # Must stay a singleton — two compactors against the same bucket corrupt data.
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: thanos-compactor
  template:
    metadata:
      labels:
        app.kubernetes.io/name: thanos-compactor
        app.kubernetes.io/part-of: thanos
    spec:
      containers:
        - name: thanos-compactor
          image: "${thanos_image}"
          args:
            - compact
            - --data-dir=/var/thanos/compact
            - --objstore.config-file=/etc/thanos/objstore.yml
            - --http-address=0.0.0.0:10902
            # Run continuously instead of one-shot.
            - --wait
            # S3 retention per resolution: keep raw 30d, 5m-downsampled 90d,
            # 1h-downsampled 1y. This is what bounds long-term S3 growth.
            - --retention.resolution-raw=30d
            - --retention.resolution-5m=90d
            - --retention.resolution-1h=365d
          ports:
            - name: http
              containerPort: 10902
          volumeMounts:
            - name: objstore-config
              mountPath: /etc/thanos
              readOnly: true
            - name: data
              mountPath: /var/thanos/compact
          resources:
            requests:
              cpu: ${thanos_compact.resources.req.cpu}
              memory: ${thanos_compact.resources.req.mem}
            limits:
              cpu: ${thanos_compact.resources.lmt.cpu}
              memory: ${thanos_compact.resources.lmt.mem}
      volumes:
        - name: objstore-config
          secret:
            secretName: thanos-objstore-config
        # Scratch space for compaction; rebuildable, so emptyDir (off EBS).
        - name: data
          emptyDir: {}
